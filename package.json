{
  "name": "h3-teamy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix || eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:extract-fixtures": "node scripts/extract-test-fixtures.js",
    "prisma:generate": "prisma generate",
    "prebuild": "node scripts/generate-icons.js",
    "postinstall": "prisma generate",
    "prepare": "husky install",
    "docs:scan": "tsx scripts/docs/scan-routes.ts",
    "docs:openapi": "tsx scripts/docs/openapi.ts",
    "docs:generate": "tsx scripts/docs/generate.ts",
    "docs:check": "node -e \"process.exit(0)\"",
    "docs:serve": "npx serve docs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sentry/nextjs": "^8.26.0",
    "bcryptjs": "^2.4.3",
    "ical": "^0.8.0",
    "ioredis": "^5.4.1",
    "next": "14.2.33",
    "next-auth": "^4.24.12",
    "node-ical": "^0.20.1",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^3.2.0",
    "sharp": "^0.33.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.12.12",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "5.4.5",
    "vitest": "^2.0.0"
  }
}
