{
  "name": "h3-teamy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prebuild": "node scripts/generate-icons.js",
    "postinstall": "prisma generate",
    "prepare": "husky install",
    "docs:scan": "tsx scripts/docs/scan-routes.ts",
    "docs:openapi": "tsx scripts/docs/openapi.ts",
    "docs:generate": "tsx scripts/docs/generate.ts",
    "docs:check": "node -e \"process.exit(0)\"",
    "docs:serve": "npx serve docs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:post-merge": "playwright test e2e/post-merge",
    "test:e2e:preview": "playwright test e2e/post-merge"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "@sentry/nextjs": "^10.49.0",
    "@tailwindcss/postcss": "^4.2.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "ical": "^0.8.0",
    "ioredis": "^5.10.1",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "node-ical": "^0.26.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.10",
    "prisma": "7.7.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "resend": "^6.12.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.6",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.4"
  }
}
