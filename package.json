{
  "name": "h3-teamy",
  "version": "0.4.6",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:preview": "vercel env pull .env.preview.local --environment=preview --yes && tsx scripts/check-preview-env.ts && dotenv -e .env.preview.local -- next dev -p 3000",
    "env:pull:preview": "vercel env pull .env.preview.local --environment=preview --yes",
    "env:pull:production": "vercel env pull .env.production.local --environment=production --yes",
    "db:migrate:preview": "dotenv -e .env.preview.local -- prisma migrate deploy",
    "db:migrate:production": "dotenv -e .env.production.local -- prisma migrate deploy",
    "db:migrate:both": "npm run db:migrate:preview && npm run db:migrate:production",
    "neon:cleanup-branches": "node scripts/neon-cleanup-branches.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:preview": "dotenv -e .env.preview.local -- tsx prisma/seed.ts",
    "arena:build-map": "tsx scripts/arena/build-map.ts",
    "arena:build-missions": "tsx scripts/arena/build-missions.ts",
    "arena:build-missions:check": "tsx scripts/arena/build-missions.ts --check",
    "arena:build-map:check": "tsx scripts/arena/build-map.ts --check",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "check:merge-conflicts": "node scripts/check-no-merge-conflict-markers.mjs",
    "arena:check-audio": "tsx scripts/arena/check-audio.ts",
    "arena:check-sprites": "tsx scripts/arena/check-sprites.ts",
    "arena:generate-audio": "tsx scripts/arena/generate-audio.ts",
    "arena:generate-radio": "tsx scripts/arena/generate-radio.ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prebuild": "node scripts/generate-icons.js && node scripts/generate-arena-sprites.js",
    "postinstall": "prisma generate",
    "prepare": "husky install",
    "docs:scan": "tsx scripts/docs/scan-routes.ts",
    "docs:openapi": "tsx scripts/docs/openapi.ts",
    "docs:generate": "tsx scripts/docs/generate.ts",
    "docs:check": "node -e \"process.exit(0)\"",
    "docs:serve": "npx serve docs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:post-merge": "playwright test e2e/post-merge",
    "test:e2e:preview": "playwright test e2e/post-merge",
    "test:arena:tv": "node e2e/arena/tv.browser.cjs && node e2e/arena/hybrid.browser.cjs",
    "eval": "braintrust eval evals",
    "arena:build-sprites": "node scripts/generate-arena-sprites.js"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "^10.75.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^14.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/speed-insights": "^2.0.0",
    "ably": "^2.28.0",
    "ai": "^7.0.106",
    "bcryptjs": "^3.0.3",
    "braintrust": "^3.34.0",
    "dotenv": "^18.0.0",
    "ical": "^0.8.0",
    "ioredis": "^6.0.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "prisma": "7.10.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.28.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/ical": "^0.8.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.6",
    "jsdom": "^30.1.0",
    "osm2geojson-lite": "2.0.1",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  }
}
