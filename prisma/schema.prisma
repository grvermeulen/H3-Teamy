datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String               @id @default(cuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  firstName           String
  lastName            String
  email               String?              @unique
  passwordHash        String?
  /**
   * Laatst gezien app-versie (wat is er nieuw / rondleiding); optioneel.
   */
  lastVersionSeen     String?
  // Optional: link to sessions/devices in future
  rsvps               Rsvp[]
  identities          Identity[]
  attendances         Attendance[]
  feedback            Feedback[]
  passkeys            Passkey[]
  passwordResetTokens PasswordResetToken[]
  arenaResults        ArenaMatchResult[]
  userRole            UserRole?
}

/**
 * Admin/trainer/player flags from the admin panel (KV + Postgres fallback).
 */
model UserRole {
  userId    String   @id
  admin     Boolean  @default(false)
  trainer   Boolean  @default(false)
  player    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Short-lived wachtwoord-reset token (KV-fallback in Postgres).
 */
model PasswordResetToken {
  token     String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * WebAuthn-passkey (Touch ID, Face ID, Windows Hello, enz.) gekoppeld aan een gebruiker.
 */
model Passkey {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  /**
   * Base64url credential-id (WebAuthn).
   */
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  /**
   * JSON-array van transports, zoals door de browser gerapporteerd.
   */
  transports   String?
  /**
   * Optionele korte weergavenaam voor de gebruiker.
   */
  label        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id          String    @id
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  title       String?
  description String?
  startDate   DateTime?
  endDate     DateTime?

  rsvps   Rsvp[]
  reports MatchReport[]
  votes   MvpVote[]
}

model MatchReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  eventId   String   @unique
  content   String
  authorId  String?
  mvpResult Json?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model MvpVote {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  eventId       String
  voterId       String
  candidateId   String
  candidateName String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, voterId])
  @@index([eventId])
  @@index([voterId])
  @@index([candidateId])
}

model Rsvp {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  eventId   String
  status    String // "yes" | "no" | "maybe"

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

model LinkCode {
  code      String   @id
  userId    String
  createdAt DateTime @default(now())
  // Expiry handled at app layer (TTL); can be pruned later
}

model Identity {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  userId         String
  provider       String // "cookie" | "email" | other providers
  providerUserId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Attendance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  date      String // YYYY-MM-DD format
  userId    String
  markedBy  String // User ID who marked the attendance

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId])
  @@index([date])
  @@index([userId])
}

enum FeedbackType {
  BUG
  IDEA
}

enum FeedbackStatus {
  NEW
  TRIAGED
  PLANNED
  SHIPPED
  DECLINED
}

model Feedback {
  id         String         @id @default(cuid())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  userId     String
  type       FeedbackType
  status     FeedbackStatus @default(NEW)
  title      String
  body       String
  route      String?
  appVersion String?
  userAgent  String?
  aiTheme    String?
  aiImpact   String?
  aiSummary  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([userId])
  @@index([status])
}

/**
 * Admin-controlled feature flag (see `src/lib/featureFlags.ts`); hidden by default until set.
 */
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String
}

/**
 * One finished GTA H3 potje (spec §9.1).
 * `roomCode` plus `startedAt` is unique, which is what makes posting a result idempotent: a host
 * that retries after a dropped response cannot record the same potje twice.
 */
model ArenaMatch {
  id         String             @id @default(cuid())
  createdAt  DateTime           @default(now())
  roomCode   String
  zone       String
  startedAt  DateTime
  endedAt    DateTime
  /**
   * Who hosted, kept for support questions; null once that account is gone.
   */
  hostUserId String?
  /** The server-issued lifecycle ID; historical results predate this field. */
  roundId    String?            @unique
  verification String           @default("host-reported")
  results    ArenaMatchResult[]

  @@unique([roomCode, startedAt])
  @@index([createdAt])
}

/** Durable authority for one room; public codes never serve as credentials. */
model ArenaRoom {
  id             String            @id @default(uuid())
  code           String            @unique
  zone           String
  createdAt      DateTime          @default(now())
  expiresAt      DateTime
  hostMemberId   String?
  hostEpoch      Int               @default(1)
  hostLeaseUntil DateTime
  members        ArenaRoomMember[]
  rounds         ArenaRound[]
  hostChanges    ArenaHostChange[]

  @@index([expiresAt])
}

/** A session-approved seat. Disconnected members remain as participant history. */
model ArenaRoomMember {
  id           String    @id @default(uuid())
  roomId       String
  userId       String
  joinNonce    String    @unique
  displayName  String
  joinedAt     DateTime  @default(now())
  seenAt       DateTime
  leftAt       DateTime?
  visible      Boolean   @default(true)
  room         ArenaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, userId])
  @@index([roomId, seenAt])
}

/** Server times and a retained roster establish exactly one casual match lifecycle. */
model ArenaRound {
  id           String                  @id @default(uuid())
  roomId       String
  startedAt    DateTime
  finishesAt   DateTime
  completedAt  DateTime?
  room         ArenaRoom               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants ArenaRoundParticipant[]

  @@index([roomId, completedAt])
}

/** A player eligible for a result even after leaving the live room. */
model ArenaRoundParticipant {
  roundId  String
  memberId String
  userId   String
  round    ArenaRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@id([roundId, memberId])
  @@unique([roundId, userId])
}

/** Every host grant is recorded with its channel epoch for migration diagnostics. */
model ArenaHostChange {
  id        String    @id @default(uuid())
  roomId    String
  memberId  String?
  epoch     Int
  createdAt DateTime  @default(now())
  room      ArenaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, epoch])
}

/**
 * One player's line in a finished potje (spec §9.1).
 */
model ArenaMatchResult {
  id      String  @id @default(cuid())
  matchId String
  userId  String
  kills   Int
  deaths  Int
  won     Boolean

  match ArenaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
}
