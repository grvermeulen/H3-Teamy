datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String  @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firstName String
  lastName  String
  email     String? @unique
  passwordHash String?
  /** Laatst gezien app-versie (what's new / tour); optioneel. */
  lastVersionSeen String?
  // Optional: link to sessions/devices in future
  rsvps     Rsvp[]
  identities Identity[]
  attendances Attendance[]
  feedback  Feedback[]
}

model Rsvp {
  id        String  @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  eventId   String
  status    String  // "yes" | "no" | "maybe"

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
  @@index([eventId])
}

model LinkCode {
  code      String  @id
  userId    String
  createdAt DateTime @default(now())
  // Expiry handled at app layer (TTL); can be pruned later
}

model Identity {
  id              String  @id @default(cuid())
  createdAt       DateTime @default(now())
  userId          String
  provider        String   // "cookie" | "email" | other providers
  providerUserId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Attendance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  date      String // YYYY-MM-DD format
  userId    String
  markedBy  String // User ID who marked the attendance

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId])
  @@index([date])
  @@index([userId])
}

enum FeedbackType {
  BUG
  IDEA
}

enum FeedbackStatus {
  NEW
  TRIAGED
  PLANNED
  SHIPPED
  DECLINED
}

model Feedback {
  id         String         @id @default(cuid())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  userId     String
  type       FeedbackType
  status     FeedbackStatus @default(NEW)
  title      String
  body       String
  route      String?
  appVersion String?
  userAgent  String?
  aiTheme    String?
  aiImpact   String?
  aiSummary  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([userId])
  @@index([status])
}

